# Copy to .env and fill in. The .env file is git-ignored.

# Optional. Only required for live briefing generation (POST /api/briefing/generate).
# Without it the demo still runs end to end using the cached briefings in data/briefings.json;
# the "Regenerate Briefing" button will return 503.
OPENAI_API_KEY=

# Comma-separated CORS allowlist. Defaults to the local Vite dev server if unset.
# In production this must include the deployed frontend origin or the browser will block requests.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
